@model Product
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="ProductName" class="form-label"></label>
        <input asp-for="ProductName" class="form-control" />
        <span asp-validation-for="ProductName" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Category" class="form-label"></label>
        <input asp-for="Category" class="form-control" placeholder="e.g. Electronics" />
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Quantity" class="form-label"></label>
        <input asp-for="Quantity" class="form-control" min="0" />
        <span asp-validation-for="Quantity" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="UnitPrice" class="form-label">Unit Price</label>
        <input asp-for="UnitPrice" class="form-control" type="number" min="0" step="0.01" />
        <span asp-validation-for="UnitPrice" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
</div>
<hr />
